<?xml version="1.0" encoding="utf-8"?>
<!-- 设置弹窗：显示模式 + 列表布局 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_mode_label"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rg_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <RadioButton
            android:id="@+id/rb_mode_flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_mode_flat"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rb_mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_mode_group"
            android:textSize="14sp" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_expand_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/expand_all"
            style="?attr/materialButtonOutlinedStyle" />

    <Button
        android:id="@+id/btn_collapse_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/collapse_all"
            style="?attr/materialButtonOutlinedStyle" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_manage_courses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/manage_manual_courses"
        style="?attr/materialButtonOutlinedStyle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/settings_layout_label"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rg_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <RadioButton
            android:id="@+id/rb_layout_single"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_layout_single"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rb_layout_double"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_layout_double"
            android:textSize="14sp" />
    </RadioGroup>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#E5E7EB" />

    <!-- 学习交流群（点击复制群号） -->
    <TextView
        android:id="@+id/tv_group_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp"
        android:gravity="center"
        android:text="@string/study_group_code"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- 联调日志（排查抓取问题用） -->
    <TextView
        android:id="@+id/tv_debug_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp"
        android:gravity="center"
        android:text="@string/view_debug_log"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- 权限放在设置底部，优先保证布局选项和课程管理在首屏可见 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#E5E7EB" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/permission_section_label"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_permission_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn_notification_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/open_notification_permission"
        style="?attr/materialButtonOutlinedStyle" />

    <Button
        android:id="@+id/btn_exact_alarm_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_exact_alarm_permission"
        style="?attr/materialButtonOutlinedStyle" />

    <Button
        android:id="@+id/btn_battery_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_battery_permission"
        style="?attr/materialButtonOutlinedStyle" />

    <Button
        android:id="@+id/btn_logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/logout"
        style="?attr/materialButtonOutlinedStyle" />
    </LinearLayout>
</ScrollView>
