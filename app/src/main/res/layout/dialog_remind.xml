<?xml version="1.0" encoding="utf-8"?>
<!-- 提醒节点设置：预设多选 + 自定义提前分钟数 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reminder_intro"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_reminder_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/cb_exact_alarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/exact_alarm_label"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btn_test_notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/test_lock_notification"
        style="?attr/materialButtonOutlinedStyle" />

    <CheckBox
        android:id="@+id/cb_1440"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/advance_one_day"
        android:textSize="15sp" />

    <CheckBox
        android:id="@+id/cb_720"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/advance_twelve_hours"
        android:textSize="15sp" />

    <CheckBox
        android:id="@+id/cb_180"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/advance_three_hours"
        android:textSize="15sp" />

    <CheckBox
        android:id="@+id/cb_60"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/advance_one_hour"
        android:textSize="15sp" />

    <CheckBox
        android:id="@+id/cb_30"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/advance_thirty_minutes"
        android:textSize="15sp" />

    <CheckBox
        android:id="@+id/cb_15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/advance_fifteen_minutes"
        android:textSize="15sp" />

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#E5E7EB" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/custom_advance_hint"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/custom_nodes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btn_add_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_custom_time"
            style="?attr/materialButtonStyle" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
